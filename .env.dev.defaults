# Chargé via env_file du service aegis-gateway (docker-compose.dev.yml) : premier fichier, puis .env pour surcharges.
# Placez ner.onnx (+ tokenizer.json) sous ./models — ex. scripts/fetch-zoka-onnx-from-ci.sh
# Schéma = AegisEngineConfig JSON (cf. crates/aegis-core/src/config/engine_yaml.rs) : bloc ner.
AEGIS_ENGINE_INIT_JSON={"ner":{"model_path":"/work/models/ner.onnx","device":"cpu","batch_size":8}}
