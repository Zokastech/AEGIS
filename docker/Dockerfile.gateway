# syntax=docker/dockerfile:1.7
# AEGIS — zokastech.fr — Apache 2.0 / MIT
#
# Gateway Go + moteur Rust (aegis-ffi, CGO, tag aegisffi). Image runtime Debian slim avec .so embarquée.

# --- Moteur Rust (cdylib) ----------------------------------------------------
FROM rust:1.99-bookworm AS rustlib

WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY benchmarks ./benchmarks
# aegis-ner / ort (load-dynamic) : embarquer libonnxruntime.so à côté de libaegis_ffi.so (runtime LD_LIBRARY_PATH=/opt/aegis).
RUN cargo build --release -p aegis-ffi \
	&& mkdir -p /src/ort-dylib \
	&& if [ -e /src/target/release/libonnxruntime.so ]; then \
		cp -L /src/target/release/libonnxruntime.so /src/ort-dylib/libonnxruntime.so; \
	fi \
	&& if [ ! -s /src/ort-dylib/libonnxruntime.so ]; then \
		_f="$(find /root/.cache/ort.pyke.io -name libonnxruntime.so -type f 2>/dev/null | head -1)"; \
		if [ -n "$_f" ]; then cp "$_f" /src/ort-dylib/libonnxruntime.so; fi; \
	fi \
	&& test -s /src/ort-dylib/libonnxruntime.so

# --- Binaire Go --------------------------------------------------------------
FROM golang:1.27-bookworm AS gobuild

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc libc6-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# v0.2.0 : plus AUCUNE clé privée TLS générée au build (elle était identique pour tous les
# utilisateurs de l’image publiée). Le certificat est créé au premier démarrage dans /var/lib/aegis/tls.

WORKDIR /src
COPY go.work ./
COPY aegis-gateway ./aegis-gateway/
COPY aegis-policy ./aegis-policy/
COPY crates/aegis-ffi/include ./crates/aegis-ffi/include
COPY --from=rustlib /src/target/release/libaegis_ffi.so /src/target/release/libaegis_ffi.so

ENV GOWORK=/src/go.work
WORKDIR /src/aegis-gateway

RUN go mod download \
    && CGO_ENABLED=1 GOOS=linux \
        go build -tags aegisffi -trimpath -ldflags="-s -w" -o /out/aegis-gateway ./cmd/aegis-gateway \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/aegis-keygen ./cmd/aegis-keygen

# --- Runtime -----------------------------------------------------------------
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 65532 --system --no-create-home --shell /usr/sbin/nologin nonroot \
    && mkdir -p /var/lib/aegis/tls \
    && chown -R 65532:65532 /var/lib/aegis \
    && chmod 0750 /var/lib/aegis /var/lib/aegis/tls

COPY --from=gobuild /out/aegis-gateway /aegis-gateway
COPY --from=gobuild /out/aegis-keygen /usr/local/bin/aegis-keygen
COPY --from=rustlib /src/target/release/libaegis_ffi.so /opt/aegis/libaegis_ffi.so
COPY --from=rustlib /src/ort-dylib/libonnxruntime.so /opt/aegis/libonnxruntime.so
COPY aegis-gateway/policies /policies
COPY docker/gateway/aegis-gateway.docker.yaml /etc/aegis/aegis-gateway.yaml
COPY docker/gateway/security.docker.yaml /etc/aegis/security.docker.yaml
COPY aegis-gateway/config/rbac.yaml /etc/aegis/rbac/rbac.yaml
COPY --chown=65532:65532 --chmod=0600 aegis-gateway/config/api_keys.yaml /var/lib/aegis/api_keys.yaml

ENV LD_LIBRARY_PATH=/opt/aegis
ENV ORT_DYLIB_PATH=/opt/aegis/libonnxruntime.so
ENV AEGIS_TLS_EXTRA_SANS=aegis-gateway

USER nonroot:nonroot
EXPOSE 8080 9090

ENTRYPOINT ["/aegis-gateway"]
# pflag : options longues en double tiret (« -config » faisait échouer le démarrage : unknown shorthand flag).
CMD ["--config", "/etc/aegis/aegis-gateway.yaml", "--security-config", "/etc/aegis/security.docker.yaml"]
