# AEGIS — copier vers `.env` : `cp .env.example .env` puis éditer les secrets.
# Référence docker-compose : postgres, redis, gateway, ZOKA-SENTINEL / NER ONNX.

# --- Postgres (docker-compose) ---
POSTGRES_USER=aegis
# Obligatoire (docker compose refuse de démarrer sinon) — ex. `openssl rand -base64 24`
POSTGRES_PASSWORD=
# Obligatoire : pepper des clés API gateway — ex. `openssl rand -hex 32`
AEGIS_API_KEY_PEPPER=
POSTGRES_DB=aegis

# --- Gateway HTTPS ---
GATEWAY_HTTPS_PORT=8443
DASHBOARD_PORT=3000
AEGIS_INSECURE_HTTP=0

# =============================================================================
# ZOKA-SENTINEL — bundle NER (model_int8.onnx + tokenizer.json) pour tests L3 en local
# Source officielle : builds GitHub [Zokastech/AEGIS](https://github.com/Zokastech/AEGIS)
# =============================================================================
# Option 0 — Artefact CI « aegis-ner-l3-onnx » (workflow Helm & NER L3) : depuis la racine du clone
#   gh auth login && ./scripts/fetch-zoka-onnx-from-ci.sh
#   (même .tgz que les options ci-dessous ; remplit ./models/ner.onnx + tokenizer.json)

# Option A — URL directe du fichier « aegis-ner-l3-onnx.tgz » (URL signée ou miroir)
# ZOKA_SENTINEL_BUNDLE_URL=https://github.com/…/aegis-ner-l3-onnx.tgz

# Option B — Dernier release GitHub : l’asset Release doit s’appeler exactement aegis-ner-l3-onnx.tgz
# (le workflow release publie surtout CLI, SBOM, chart Helm ; le bundle NER est surtout en artefact Actions)
# ZOKA_SENTINEL_FETCH_LATEST=1
# ZOKA_SENTINEL_REPO=Zokastech/AEGIS
# GITHUB_TOKEN=   # optionnel (public) ; requis pour dépôt privé et meilleure limite de quota API

# Option C — Legacy : un seul fichier .onnx (sans tokenizer dans l’URL ; L3 incomplet côté inférence réelle)
# NER_ONNX_URL=

# --- docker-compose.dev.yml — passerelle Go + FFI (Playground L3) ---
# Le service aegis-gateway charge env_file : .env.dev.defaults puis .env (ce dernier optionnel, required: false).
# Sans env_file, AEGIS_ENGINE_INIT_JSON défini seulement dans le .env à la racine du projet n’atteint pas le conteneur
# (Compose l’utilise pour l’interpolation du YAML, pas comme variables d’environnement du service) — d’où
# « L3 NER indisponible : aucun ner.model_path » malgré ner.onnx présent sous ./models.
# Créez ./models avec ner.onnx + tokenizer.json (bundle ZOKA ci-dessus), puis make dev.
# Pour désactiver le NER : dans .env, AEGIS_ENGINE_INIT_JSON={}
# Pour surcharger (ex. INT8) :
# AEGIS_ENGINE_INIT_JSON={"ner":{"model_path":"/work/models/model_int8.onnx","device":"cpu","batch_size":8}}

# --- docker-compose.yml (stack prod-like) — passerelle : volume modèles sous /opt/aegis/models ---
# Définir après téléchargement onnx-init (ZOKA_SENTINEL_* ou NER_ONNX_URL) :
# AEGIS_ENGINE_INIT_JSON={"ner":{"model_path":"/opt/aegis/models/ner.onnx","device":"cpu","batch_size":8}}
# (sinon la clé engine_init_json du fichier /etc/aegis/aegis-gateway.yaml dans l’image s’applique si vous ne forcez pas l’env)
